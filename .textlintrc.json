{
  "plugin": [
    {
      "id": "@textlint/textlint-plugin-latex2e",
      "options": {}
    },
    {
      "id": "@textlint/textlint-plugin-markdown",
      "options": {}
    },
    {
      "id": "@textlint/textlint-plugin-text",
      "options": {}
    }
  ],
  "plugins": ["latex2e"],
  "filters": {
    "comments": true
  },
  "rules": {
    "spelling": {
      "language": "en",
      "skipPatterns": [
        "CHANGELOG",
        "CalVer",
        "CodeQL",
        "Changelog",
        "CODEOWNER",
        "CLI",
        "CVSS",
        "DCO",
        "Dependabot",
        "e2e",
        "JavaScript",
        "MacOS",
        "Makefile",
        "Node.js",
        "NPO",
        "OpenSSF",
        "UI",
        "POS",
        "PR",
        "YAML",
        "/[Ff]ormatter/",
        "/[Ll]inter/",
        "/[Pp]re/",
        "/[Rr]untime/",
        "/[Ss]exualized/",
        "/[Ss]ocio-economic/",
        "/[Uu]serspace/",
        "/[Vv]endored/",
        "/[Vv]irtualenv/",
        "/v[0-9]+/",
        "/[0-9]+/",
        ":white_check_mark:",
        "Miklós",
        "Csűrös",
        "ABI",
        "API",
        "BPF",
        "Backbone.js",
        "BeProud",
        "Bigtable",
        "Bridgewater",
        "CFP",
        "CoffeeScript",
        "Connpass",
        "Containerd",
        "Datatel",
        "Ellucian",
        "EuroPython",
        "Fairfax",
        "GDE",
        "GKE",
        "JLPT",
        "Knative",
        "KubeCon",
        "Kubernetes",
        "Netlink",
        "Node.js",
        "OCI",
        "PyCon",
        "SIPSS",
        "SLSA",
        "SSO",
        "Sigstore",
        "Seccomp",
        "XML:FO",
        "gVisor",
        "Linux",
        "leftmargin",
        "minikube",
        "npm",
        "procfs",
        "require.js",
        "/[Aa]ddon/",
        "/[Bb]ackend/",
        "/[Cc]ustomizability/",
        "/[Ff]rontend/",
        "/[Ss]tylesheet/",
        "/[Uu]ntrusted/"
      ]
    }
  }
}
